{
  "$schema": "https://calm.finos.org/release/1.3/meta/calm.json",
  "unique-id": "ecommerce-platform-architecture",
  "name": "E-Commerce Platform",
  "description": "A microservices-based e-commerce platform for processing customer orders.",
  "metadata": {
    "owner": "E-Commerce Platform Team",
    "ownership-status": "placeholder; confirm the responsible team",
    "repository": "https://example.com/ecommerce-platform",
    "repository-status": "placeholder; replace with the actual repository",
    "version": "1.0.0",
    "created": "2026-11-16",
    "description": "E-commerce order processing platform",
    "tags": [
      "ecommerce",
      "microservices",
      "orders"
    ]
  },
  "nodes": [
    {
      "unique-id": "customer",
      "node-type": "actor",
      "name": "Customer",
      "description": "A customer who browses the store and places orders."
    },
    {
      "unique-id": "admin",
      "node-type": "actor",
      "name": "Admin",
      "description": "An administrator who manages products, inventory, and orders."
    },
    {
      "unique-id": "ecommerce-platform",
      "node-type": "system",
      "name": "E-Commerce Platform",
      "description": "The overall platform containing the e-commerce services.",
      "metadata": {
        "owner": "E-Commerce Platform Team",
        "repository": "https://example.com/ecommerce-platform",
        "deployment-type": "containerized",
        "sla-tier": "tier-1",
        "repository-status": "placeholder; replace with the actual repository"
      }
    },
    {
      "unique-id": "api-gateway",
      "node-type": "service",
      "name": "API Gateway",
      "description": "The entry point that routes customer and administrator requests to platform services.",
      "interfaces": [
        {
          "unique-id": "api-gateway-https",
          "protocol": "HTTPS",
          "host": "api.example.com",
          "port": 443,
          "path": "/api/v1",
          "description": "Public HTTPS entry point for customer and administrator APIs."
        }
      ],
      "metadata": {
        "owner": "E-Commerce Platform Team",
        "repository": "https://example.com/ecommerce-platform",
        "deployment-type": "container",
        "sla-tier": "tier-1",
        "repository-status": "placeholder; replace with the actual repository"
      }
    },
    {
      "unique-id": "order-service",
      "node-type": "service",
      "name": "Order Service",
      "description": "Creates and manages customer orders and coordinates inventory and payment processing.",
      "interfaces": [
        {
          "unique-id": "order-service-api",
          "protocol": "HTTPS",
          "host": "orders.internal.example.com",
          "port": 8081,
          "path": "/api/v1/orders",
          "description": "Internal HTTPS API for creating and managing orders."
        },
        {
          "unique-id": "order-service-order-database-jdbc",
          "protocol": "JDBC",
          "host": "orders-db.example.com",
          "port": 5432,
          "database": "orders",
          "description": "Outbound JDBC connection to the Order Database."
        }
      ],
      "metadata": {
        "owner": "E-Commerce Platform Team",
        "repository": "https://example.com/ecommerce-platform",
        "deployment-type": "container",
        "sla-tier": "tier-1",
        "repository-status": "placeholder; replace with the actual repository"
      }
    },
    {
      "unique-id": "inventory-service",
      "node-type": "service",
      "name": "Inventory Service",
      "description": "Tracks product stock and reserves inventory for orders.",
      "interfaces": [
        {
          "unique-id": "inventory-service-api",
          "protocol": "HTTPS",
          "host": "inventory.internal.example.com",
          "port": 8082,
          "path": "/api/v1/inventory",
          "description": "Internal HTTPS API for inventory lookup and reservation."
        },
        {
          "unique-id": "inventory-service-inventory-database-jdbc",
          "protocol": "JDBC",
          "host": "inventory-db.example.com",
          "port": 5432,
          "database": "inventory",
          "description": "Outbound JDBC connection to the Inventory Database."
        }
      ],
      "metadata": {
        "owner": "E-Commerce Platform Team",
        "repository": "https://example.com/ecommerce-platform",
        "deployment-type": "container",
        "sla-tier": "tier-1",
        "repository-status": "placeholder; replace with the actual repository"
      }
    },
    {
      "unique-id": "payment-service",
      "node-type": "service",
      "name": "Payment Service",
      "description": "Authorizes and records payments for customer orders.",
      "interfaces": [
        {
          "unique-id": "payment-service-api",
          "protocol": "HTTPS",
          "host": "payments.internal.example.com",
          "port": 8083,
          "path": "/api/v1/payments",
          "description": "Internal HTTPS API for authorizing and recording order payments."
        }
      ],
      "metadata": {
        "owner": "E-Commerce Platform Team",
        "repository": "https://example.com/ecommerce-platform",
        "deployment-type": "container",
        "sla-tier": "tier-1",
        "repository-status": "placeholder; replace with the actual repository"
      }
    },
    {
      "unique-id": "order-database",
      "node-type": "database",
      "name": "Order Database",
      "description": "Stores order records and their processing status.",
      "interfaces": [
        {
          "unique-id": "order-database-jdbc",
          "protocol": "JDBC",
          "host": "orders-db.example.com",
          "port": 5432,
          "database": "orders"
        }
      ],
      "metadata": {
        "owner": "E-Commerce Platform Team",
        "repository": "https://example.com/ecommerce-platform",
        "deployment-type": "managed-database",
        "sla-tier": "tier-1",
        "repository-status": "placeholder; replace with the actual repository"
      }
    },
    {
      "unique-id": "inventory-database",
      "node-type": "database",
      "name": "Inventory Database",
      "description": "Stores product inventory quantities and reservations.",
      "interfaces": [
        {
          "unique-id": "inventory-database-jdbc",
          "protocol": "JDBC",
          "host": "inventory-db.example.com",
          "port": 5432,
          "database": "inventory"
        }
      ],
      "metadata": {
        "owner": "E-Commerce Platform Team",
        "repository": "https://example.com/ecommerce-platform",
        "deployment-type": "managed-database",
        "sla-tier": "tier-1",
        "repository-status": "placeholder; replace with the actual repository"
      }
    }
  ],
  "relationships": [
    {
      "unique-id": "customer-interacts-with-api-gateway",
      "description": "The customer sends store requests through the API Gateway.",
      "relationship-type": {
        "interacts": {
          "actor": "customer",
          "nodes": [
            "api-gateway"
          ]
        }
      }
    },
    {
      "unique-id": "admin-interacts-with-api-gateway",
      "description": "The administrator accesses platform functions through the API Gateway.",
      "relationship-type": {
        "interacts": {
          "actor": "admin",
          "nodes": [
            "api-gateway"
          ]
        }
      }
    },
    {
      "unique-id": "ecommerce-platform-composed-of-components",
      "description": "The E-Commerce Platform consists of its gateway, services, and databases.",
      "relationship-type": {
        "composed-of": {
          "container": "ecommerce-platform",
          "nodes": [
            "api-gateway",
            "order-service",
            "inventory-service",
            "payment-service",
            "order-database",
            "inventory-database"
          ]
        }
      }
    },
    {
      "unique-id": "api-gateway-routes-to-order-service",
      "description": "The API Gateway forwards order requests to the Order Service.",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "api-gateway",
            "interfaces": [
              "api-gateway-https"
            ]
          },
          "destination": {
            "node": "order-service",
            "interfaces": [
              "order-service-api"
            ]
          }
        }
      },
      "metadata": {
        "latency-sla": "Illustrative target: p95 < 100ms over a rolling 5-minute window; confirm with service owner.",
        "monitoring": [
          "latency",
          "error rate",
          "availability"
        ],
        "circuit-breaker": true
      }
    },
    {
      "unique-id": "api-gateway-connects-to-inventory-service",
      "description": "The API Gateway forwards inventory requests to the Inventory Service.",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "api-gateway",
            "interfaces": [
              "api-gateway-https"
            ]
          },
          "destination": {
            "node": "inventory-service",
            "interfaces": [
              "inventory-service-api"
            ]
          }
        }
      },
      "metadata": {
        "latency-sla": "Illustrative target: p95 < 100ms over a rolling 5-minute window; confirm with service owner.",
        "monitoring": [
          "latency",
          "error rate",
          "availability"
        ],
        "circuit-breaker": true
      }
    },
    {
      "unique-id": "order-service-connects-to-inventory-service",
      "description": "The Order Service requests inventory availability and reservations for an order.",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "order-service",
            "interfaces": [
              "order-service-api"
            ]
          },
          "destination": {
            "node": "inventory-service",
            "interfaces": [
              "inventory-service-api"
            ]
          }
        }
      },
      "metadata": {
        "latency-sla": "Illustrative target: p95 < 100ms over a rolling 5-minute window; confirm with service owner.",
        "monitoring": [
          "latency",
          "error rate",
          "availability"
        ],
        "circuit-breaker": true
      }
    },
    {
      "unique-id": "order-service-connects-to-payment-service",
      "description": "The Order Service sends payment requests to the Payment Service.",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "order-service",
            "interfaces": [
              "order-service-api"
            ]
          },
          "destination": {
            "node": "payment-service",
            "interfaces": [
              "payment-service-api"
            ]
          }
        }
      },
      "metadata": {
        "latency-sla": "Illustrative target: p95 < 100ms over a rolling 5-minute window; confirm with service owner.",
        "monitoring": [
          "latency",
          "error rate",
          "availability"
        ],
        "circuit-breaker": true
      }
    },
    {
      "unique-id": "order-service-connects-to-order-database",
      "description": "The Order Service stores and retrieves order data in the Order Database.",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "order-service",
            "interfaces": [
              "order-service-order-database-jdbc"
            ]
          },
          "destination": {
            "node": "order-database",
            "interfaces": [
              "order-database-jdbc"
            ]
          }
        }
      },
      "metadata": {
        "latency-sla": "Illustrative target: p95 < 100ms over a rolling 5-minute window; confirm with service owner.",
        "monitoring": [
          "latency",
          "error rate",
          "availability"
        ],
        "circuit-breaker": false,
        "failure-handling": "Use connection-pool limits, query timeouts, and bounded retries."
      }
    },
    {
      "unique-id": "inventory-service-connects-to-inventory-database",
      "description": "The Inventory Service stores and retrieves stock data in the Inventory Database.",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "inventory-service",
            "interfaces": [
              "inventory-service-inventory-database-jdbc"
            ]
          },
          "destination": {
            "node": "inventory-database",
            "interfaces": [
              "inventory-database-jdbc"
            ]
          }
        }
      },
      "metadata": {
        "latency-sla": "Illustrative target: p95 < 100ms over a rolling 5-minute window; confirm with service owner.",
        "monitoring": [
          "latency",
          "error rate",
          "availability"
        ],
        "circuit-breaker": false,
        "failure-handling": "Use connection-pool limits, query timeouts, and bounded retries."
      }
    }
  ],
  "flows": [
    {
      "unique-id": "customer-order-processing",
      "name": "Customer Order Processing",
      "description": "Customer submits an order; the platform checks and reserves inventory, authorizes payment, and persists the order.",
      "transitions": [
        {
          "relationship-unique-id": "customer-interacts-with-api-gateway",
          "sequence-number": 1,
          "description": "Customer submits an order request through the API Gateway."
        },
        {
          "relationship-unique-id": "api-gateway-routes-to-order-service",
          "sequence-number": 2,
          "description": "The API Gateway forwards the order request to the Order Service."
        },
        {
          "relationship-unique-id": "order-service-connects-to-inventory-service",
          "sequence-number": 3,
          "description": "The Order Service checks availability and requests an inventory reservation."
        },
        {
          "relationship-unique-id": "inventory-service-connects-to-inventory-database",
          "sequence-number": 4,
          "description": "The Inventory Service reads and updates the inventory reservation."
        },
        {
          "relationship-unique-id": "order-service-connects-to-payment-service",
          "sequence-number": 5,
          "description": "The Order Service requests payment authorization."
        },
        {
          "relationship-unique-id": "order-service-connects-to-order-database",
          "sequence-number": 6,
          "description": "The Order Service persists the order and its processing status."
        }
      ]
    }
  ]
}
